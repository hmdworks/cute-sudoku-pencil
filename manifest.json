
{
    "manifest_version": 3,
    "name": "Cute Sudoku Pencil",
    "version": "1.0.0",
    "description": "Your little Sudoku helper ♡",

    "permissions": ["storage"],

    "action": {
        "default_popup": "popup/popup.html",
        "default_title": "Cute Sudoku Pencil"
    },

    "content_scripts": [
        {
            "matches": ["https://www.nytimes.com/puzzles/sudoku*"],
            "js": ["scripts/theme.js"],
            "css": ["styles/styles.css"],
            "run_at": "document_start",
            "world": "ISOLATED"
        },
        {
            "matches": ["https://www.nytimes.com/puzzles/sudoku*"],
            "js": ["scripts/page.js"],
            "run_at": "document_idle",
            "world": "MAIN"
        },
        {
            "matches": ["https://www.nytimes.com/puzzles/sudoku*"],
            "js": ["scripts/candidates.js", "scripts/content.js"],
            "run_at": "document_idle",
            "world": "ISOLATED"
        }
    ],

    "web_accessible_resources": [
    {
        "resources": ["sounds/yay.mp3"],
        "matches": ["https://www.nytimes.com/*"]
    }
    ]
}

